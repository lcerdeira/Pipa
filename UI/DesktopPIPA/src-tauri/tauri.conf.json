{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "http://localhost:8080",
    "distDir": "../dist/spa"
  },
  "package": {
    "productName": "PIPA",
    "version": "2.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": true,
        "sidecar": true,
        "scope": [
          {
            "name": "python3",
            "cmd": "python3",
            "args": true
          }
        ]
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": false,
        "readDir": true,
        "scope": ["$APPDATA/**", "$HOME/**"]
      },
      "http": {
        "all": false,
        "request": true,
        "scope": ["http://127.0.0.1:5000/**", "http://localhost:5000/**"]
      }
    },
    "bundle": {
      "active": true,
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "io.github.lcerdeira.pipa",
      "targets": "all",
      "category": "public.app-category.education",
      "shortDescription": "Pipeline for Microbial Genomic Analysis",
      "longDescription": "PIPA is an integrated platform for microbial genomic analysis supporting Illumina, Nanopore, and PacBio sequencing data.",
      "macOS": {
        "minimumSystemVersion": "10.15"
      },
      "windows": {
        "wix": {
          "language": "en-US"
        }
      },
      "deb": {
        "depends": ["python3", "python3-pip"]
      }
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:5000 http://localhost:5000; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "PIPA - Pipeline for Microbial Genomic Analysis",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
